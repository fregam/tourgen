# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
# Higgsfield credentials, format key_id:key_secret
HF_KEY=
# Optional overrides (see tourgen/config.py for all settings, prefix TOURGEN_)
# TOURGEN_JOBS_DIR=jobs
# TOURGEN_HF_CONCURRENCY=4
# TOURGEN_BUDGET_USD=25

# Email delivery of the final videos (optional; needed for --email)
# Gmail: create an app password at https://myaccount.google.com/apppasswords
# TOURGEN_SMTP_HOST=smtp.gmail.com
# TOURGEN_SMTP_PORT=587
# TOURGEN_SMTP_USER=you@gmail.com
# TOURGEN_SMTP_PASSWORD=
# TOURGEN_SMTP_FROM=you@gmail.com
